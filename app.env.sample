# app.env.sample
# Copy to app.env and adjust values before starting the stack.
# These variables override the matching values in default.env for this app.
# No `export` prefix - this file is read by `docker compose --env-file`.

TZ=America/New_York
BASE_DOMAIN_NAME=example.com
BASE_HOST_NAME=zammad.example.com

APP_ORG_NAME=Zammad

DB_USER_NAME=zammad
DB_USER_PASS=replace-with-a-random-password
DB_CREATE_DATABASE_NAME=zammad_production

# ZAMMAD_HTTP_TYPE=http keeps the nginx port at 8080. Set to https when the
# internal nginx terminates TLS instead of the reverse proxy.
ZAMMAD_HTTP_TYPE=http
ZAMMAD_RAILS_TRUSTED_PROXIES=

# Worker tuning, left blank uses the image defaults
ZAMMAD_WEB_CONCURRENCY=
ZAMMAD_PROCESS_SESSIONS_JOBS_WORKERS=
ZAMMAD_PROCESS_SCHEDULED_JOBS_WORKERS=
ZAMMAD_PROCESS_DELAYED_JOBS_WORKERS=

# Auto wizard, e.g. {"organization_name":"Example","locale":"en"}
ZAMMAD_AUTOWIZARD_JSON=
ZAMMAD_AUTOWIZARD_RELATIVE_PATH=
